logging {
  level  = "info"
  format = "logfmt"
}

otelcol.receiver.otlp "lab" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    logs   = [otelcol.processor.memory_limiter.lab.input]
    metrics = [otelcol.processor.memory_limiter.lab.input]
    traces = [otelcol.processor.memory_limiter.lab.input]
  }
}

otelcol.processor.memory_limiter "lab" {
  check_interval = "1s"
  limit          = "256MiB"
  spike_limit    = "64MiB"

  output {
    logs   = [otelcol.processor.transform.identity_projection.input]
    metrics = [otelcol.processor.transform.identity_projection.input]
    traces = [otelcol.processor.transform.identity_projection.input]
  }
}

otelcol.processor.transform "identity_projection" {
  error_mode = "propagate"

  trace_statements {
    context = "span"
    statements = [
      `delete_key(attributes, "user.email")`,
      `delete_key(attributes, "auth.token")`,
    ]
  }

  log_statements {
    context = "log"
    statements = [
      `delete_key(attributes, "user.email")`,
      `delete_key(attributes, "auth.token")`,
      `delete_key(attributes, "code.file.path")`,
      `delete_key(attributes, "code.function.name")`,
      `delete_key(attributes, "code.line.number")`,
    ]
  }

  metric_statements {
    context = "datapoint"
    statements = [
      `delete_key(attributes, "user.email")`,
      `delete_key(attributes, "auth.token")`,
      `delete_key(attributes, "conversation.id")`,
      `delete_key(attributes, "ithelp.governance.action_id")`,
      `delete_key(attributes, "principal.ref")`,
      `delete_key(attributes, "session.id")`,
      `delete_key(attributes, "user.id")`,
    ]
  }

  output {
    logs   = [otelcol.processor.batch.lab.input]
    metrics = [otelcol.processor.batch.lab.input]
    traces = [otelcol.processor.batch.lab.input]
  }
}

otelcol.processor.batch "lab" {
  timeout         = "1s"
  send_batch_size = 128

  output {
    logs   = [otelcol.exporter.otlphttp.lgtm.input]
    metrics = [otelcol.exporter.otlphttp.lgtm.input]
    traces = [otelcol.exporter.otlphttp.lgtm.input]
  }
}

otelcol.exporter.otlphttp "lgtm" {
  client {
    endpoint = "http://lgtm:4318"
  }
}

prometheus.scrape "agentgateway" {
  targets = [{
    "__address__" = "agentgateway:15020",
    "job"         = "agentgateway-data-plane",
  }]
  forward_to = [prometheus.remote_write.lgtm.receiver]
}

prometheus.remote_write "lgtm" {
  endpoint {
    url = "http://lgtm:9090/api/v1/write"
  }
}
